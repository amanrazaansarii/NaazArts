datasource db {
  provider = "sqlite"
  url      = "file:../naazarts.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("USER") // "USER" | "ADMIN"
  memberSince  String    @default("August 2026")
  avatarText   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  street    String
  city      String
  state     String
  zipCode   String
  country   String   @default("United States")
  phone     String?
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("categories")
}

model Product {
  id               String    @id
  slug             String    @unique
  name             String
  categoryName     String
  price            String
  priceValue       Float
  swatch           String
  badge            String?
  image            String?
  images           String?   // JSON array of image URLs
  prices           String?   // JSON object: { USD: 28, INR: 2299, EUR: 26, GBP: 22 }
  description      String
  details          String    // JSON array of strings
  dimensions       String
  weight           String
  inStock          Boolean   @default(true)
  stockStatus      String    @default("IN_STOCK") // "IN_STOCK" | "OUT_OF_STOCK" | "UNAVAILABLE"
  productionStatus String    @default("READY")    // "READY" | "CASTING" | "CURING" | "RESTOCKING"
  leadTime         String
  colors           String?   // JSON array of color objects
  variants         String?   // JSON array of rich variant objects
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category         Category  @relation(fields: [categoryName], references: [name])

  @@map("products")
}

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Float
  minItems        Int      @default(1)
  firstOrderOnly  Boolean  @default(false)
  requiresAuth    Boolean  @default(false)
  isActive        Boolean  @default(true)
  description     String
  createdAt       DateTime @default(now())

  @@map("promo_codes")
}

model Order {
  id                String           @id // e.g. "#NAS-XXXXXX"
  userId            String?
  guestEmail        String?
  status            String           @default("CONFIRMED") // CONFIRMED, CASTING, PACKING, DISPATCHED, DELIVERED, CANCELLED
  subtotal          Float
  discount          Float            @default(0)
  shipping          Float            @default(0)
  total             Float
  promoCode         String?
  carrier           String           @default("Artisan Courier Direct")
  estimatedDelivery String
  shippingAddress   String           // JSON string of UserAddress
  items             String           // JSON string of CartItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  milestones        OrderMilestone[]

  @@map("orders")
}

model OrderMilestone {
  id          String   @id @default(cuid())
  orderId     String
  title       String
  description String
  timestamp   String
  completed   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_milestones")
}

model Review {
  id             String   @id @default(cuid())
  customerName   String
  customerAvatar String?
  source         String   @default("Instagram") // "Instagram" | "WhatsApp" | "Google" | "Website" | "Studio Visitor"
  sourceUrl      String?
  rating         Int      @default(5)
  reviewText     String
  productSlug    String?
  reviewDate     String
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reviews")
}

model ContactSubmission {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  type            String   @default("General inquiry") // "General inquiry" | "Custom order" | "Wholesale / bulk jars" | "Workshop question" | "Workshop Registration"
  workshopSession String?
  message         String
  status          String   @default("NEW") // "NEW" | "IN_PROGRESS" | "RESPONDED" | "ARCHIVED"
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contact_submissions")
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("In-person") // "In-person" | "Online"
  date        String
  location    String
  price       String
  priceValue  Float
  maxSeats    Int      @default(12)
  bookedSeats Int      @default(0)
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workshops")
}
